generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─── Enums ──────────────────────────────────────────────────────────────────

enum UserRole {
  ADMIN
  EMPLOYEE
}

enum PolicyDocumentStatus {
  PENDING
  PROCESSING
  READY
  FAILED
}

enum RuleSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum PolicyAction {
  ALLOW
  BLOCK
}

enum MaskKind {
  SENIOR_OFFICER
  TELCO_HUB_NODE
  PROPRIETARY_SERVICE
}

// Sensitive-Data Layer: policy document lifecycle (DRAFT → REVIEW → ACTIVE → ARCHIVED)
enum PolicyLifecycle {
  DRAFT
  REVIEW
  ACTIVE
  ARCHIVED
}

// Sensitive-Data Layer: per-rule review state
enum RuleStatus {
  DRAFT
  REVIEW
  ACTIVE
  ARCHIVED
  REJECTED
  PENDING_LLM
}

// Sensitive-Data Layer: which deterministic detector produced a rule
enum RuleDetectorType {
  REGEX
  CHECKSUM
  DICTIONARY
  SEMANTIC
}

// Sensitive-Data Layer: what the runtime must do when a compiled rule hits
enum CompiledRuleAction {
  BLOCK_EXTERNAL
  MASK
  FLAG_REVIEW
}

// ─── Phase 1: Policy Concept Enums ──────────────────────────────────────────

enum ConceptSensitivity {
  PUBLIC
  INTERNAL
  CONFIDENTIAL
  HIGHLY_CONFIDENTIAL
}

enum ConceptAction {
  ALLOW_EXTERNAL
  ROUTE_LOCAL
  MASK_AND_ALLOW_EXTERNAL
  BLOCK
}

enum ConceptReviewStatus {
  DRAFT
  REVIEW        // پیش‌فرض پس از استخراج LLM (spec §13: بدون تأیید فعال نمی‌شود)
  ACTIVE
  ARCHIVED
  REJECTED
}

enum PolicyUnitType {
  HEADING
  PARAGRAPH
  BULLET_GROUP
  TABLE
  CLAUSE
}

// ─── Organization ───────────────────────────────────────────────────────────

model Organization {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users           User[]
  policyDocuments PolicyDocument[]
  policyRules     PolicyRule[]
  decisionLogs    PolicyDecisionLog[]
  chatSessions    ChatSession[]
  maskDictionary  MaskDictionary[]
  policyAuditLogs PolicyAuditLog[]
  policyConcepts  PolicyConcept[]
}

// ─── User ───────────────────────────────────────────────────────────────────

model User {
  id             String    @id @default(cuid())
  email          String    @unique
  name           String?
  passwordHash   String
  role           UserRole  @default(EMPLOYEE)
  organizationId String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization    Organization      @relation(fields: [organizationId], references: [id])
  policyDocuments PolicyDocument[]
  decisionLogs    PolicyDecisionLog[]
  chatSessions    ChatSession[]
  browserSessions UserSession[]
}

// ─── Browser Session (compact-cookie auth fallback) ─────────────────────────

model UserSession {
  id        String   @id // sha256 hash of the opaque session token
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// ─── Policy Document ────────────────────────────────────────────────────────

model PolicyDocument {
  id               String              @id @default(cuid())
  organizationId   String
  filename         String
  mimeType         String              @default("application/pdf")
  size             Int
  storagePath      String
  uploadedById     String
  status           PolicyDocumentStatus @default(PENDING)
  version          Int                 @default(1)
  isActive         Boolean             @default(false)
  extractedCharCount Int?
  errorMessage     String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  // ── Sensitive-Data Layer: ingestion provenance & lifecycle ──
  sourceType       String              @default("PDF")   // PDF | TXT | MD
  lifecycle        PolicyLifecycle     @default(DRAFT)
  compiledRules    String?             // JSON: CompiledPolicyRule[] (written on activation)
  reviewedAt       DateTime?
  activatedAt      DateTime?

  // ── Phase 1: Concept extraction & semantic indexing fields ──
  conceptExtractionStatus String?   // PENDING | RUNNING | DONE | FAILED
  conceptStats            String?   // JSON: {units, concepts, rejected, pendingReview}
  indexedAt               DateTime? // آخرین زمان rebuild ایندکس برداری

  organization Organization @relation(fields: [organizationId], references: [id])
  uploadedBy  User          @relation(fields: [uploadedById], references: [id])
  chunks      PolicyChunk[]
  rules       PolicyRule[]
  units       PolicyUnit[]
  concepts    PolicyConcept[]
}

// ─── Policy Chunk ───────────────────────────────────────────────────────────

model PolicyChunk {
  id               String  @id @default(cuid())
  documentId       String
  index            Int              // ordinal within the document (0-based)
  content          String
  normalizedContent String
  isRestricted     Boolean @default(false)

  // ── Sensitive-Data Layer: provenance & candidate marking ──
  pageIndex        Int?      // 1-based source page (null for TXT without pages)
  textHash         String?   // sha256 of the exact chunk text (stable id)
  spanStart        Int?      // char offset in the full extracted text
  spanEnd          Int?
  isCandidate      Boolean @default(false) // marked by deterministic keyword filter

  document PolicyDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@index([documentId, index])
}

// ─── Policy Rule ────────────────────────────────────────────────────────────

model PolicyRule {
  id             String       @id @default(cuid())
  documentId     String?
  organizationId String
  code           String
  title          String
  body           String?
  keywords       String       @default("[]")  // JSON array of strings
  patterns       String       @default("[]")  // JSON array of regex strings
  severity       RuleSeverity @default(MEDIUM)
  category       String?
  isActive       Boolean      @default(true)
  isManual       Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  // ── Sensitive-Data Layer: review lifecycle & detector typing ──
  status         RuleStatus         @default(ACTIVE)
  detectorType   RuleDetectorType   @default(SEMANTIC)
  checksumKind   String?            // IR_NATIONAL_ID | IR_BANK_CARD | IBAN
  dictionaryId   String?            // MaskDictionary reference (future)
  action         CompiledRuleAction @default(BLOCK_EXTERNAL)
  priority       Int                @default(100)   // lower = higher priority
  sourceQuote    String?            // mandatory provenance quote from the chunk
  sourcePage     Int?
  textHash       String?            // stable dedupe hash (normalized rule identity)
  conflictGroup  String?            // rules with overlapping scope but different actions
  reviewNote     String?            // e.g. "duplicate of R-004" / rejection reason
  chunkId        String?            // originating chunk (provenance)

  document     PolicyDocument? @relation(fields: [documentId], references: [id], onDelete: SetNull)
  organization Organization    @relation(fields: [organizationId], references: [id])
  decisionLogs PolicyDecisionLog[] @relation("RuleToLog")

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([organizationId, status])
  @@index([documentId])
}

// ─── Policy Audit Log (Sensitive-Data Layer — NO raw sensitive content) ────

model PolicyAuditLog {
  id             String   @id @default(cuid())
  organizationId String
  actorId        String?  // User id (null = system/background)
  action         String   // UPLOAD | CHUNKING | RULE_PROPOSE | RULE_ACCEPT | RULE_REJECT | ACTIVATE | LIFECYCLE | RUNTIME_SENSITIVE | RUNTIME_UNCERTAIN | ...
  targetType     String   // POLICY_DOCUMENT | POLICY_RULE | POLICY_CHUNK | RUNTIME_DECISION
  targetId       String?
  metadataJson   String   @default("{}") // hashes/counts/types/ids ONLY — never raw sensitive text
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId, createdAt])
  @@index([action])
}

// ─── Mask Dictionary (Sanitizer dictionaries, Phase 3) ─────────────────────

model MaskDictionary {
  id             String   @id @default(cuid())
  organizationId String
  kind           MaskKind
  term           String
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, kind, term])
  @@index([organizationId, kind])
}

// ─── Policy Decision Log ────────────────────────────────────────────────────

model PolicyDecisionLog {
  id             String       @id @default(cuid())
  userId         String
  organizationId String
  action         PolicyAction
  score          Float        @default(0)
  reasons        String       @default("[]")  // JSON array of strings
  matchedRuleIds String       @default("[]")  // JSON array of rule ids
  promptHash     String
  promptPreview  String
  promptLength   Int
  latencyMs      Int
  engineVersion  String
  createdAt      DateTime     @default(now())

  // ── Phase 3: Smart DLP & Prompt Routing audit fields ──
  route               String?  // EXTERNAL | LOCAL | BLOCKED (null = legacy rows / engine-only)
  maskCount           Int      @default(0)
  maskLabels          String   @default("[]") // JSON array of {label, count}
  isSensitive         Boolean?
  classifierCategory  String?
  classifierRisk      String?  // low | medium | high | critical
  classifierReason    String?
  classifierLatencyMs Int?
  sourceIp            String?
  promptTokens        Int?
  completionTokens    Int?

  // ── Phase 1 / Semantic Pipeline audit fields (spec §37) ──
  sensitivity        String?   // PUBLIC | INTERNAL | CONFIDENTIAL | HIGHLY_CONFIDENTIAL
  matchedConceptIds  String    @default("[]")  // JSON
  retrievalScores    String?   // JSON: [{conceptId, score}]
  classifierMethod   String?   // local_llm | deterministic | heuristic | fallback
  egressMode         String?   // DIRECT | MASKED | NONE
  policyVersion      Int?      // نسخه سند سیاست فعال در لحظه تصمیم
  pipelineHealth     String?   // HEALTHY | DEGRADED | FAILED

  user         User        @relation(fields: [userId], references: [id])
  organization  Organization @relation(fields: [organizationId], references: [id])
  matchedRules PolicyRule[]  @relation("RuleToLog")

  @@index([organizationId])
  @@index([createdAt])
}

// ─── Chat Session ───────────────────────────────────────────────────────────

model ChatSession {
  id             String   @id @default(cuid())
  userId         String
  organizationId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user         User         @relation(fields: [userId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])
  messages     ChatMessage[]

  @@index([userId])
}

// ─── Chat Message (persisted) ───────────────────────────────────────────────

model ChatMessage {
  id         String   @id @default(cuid())
  sessionId  String
  role       String   // "user" | "assistant" | "system"
  content    String
  createdAt  DateTime @default(now())

  session ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}

// ─── Phase 1: Policy Unit (Semantic Segmenter output — spec §11) ───────────

model PolicyUnit {
  id             String         @id @default(cuid())
  documentId     String
  ordinal        Int
  page           Int?           // 1-based (null for sources without pages)
  sectionTitle   String?
  text           String
  normalizedText String
  unitType       PolicyUnitType
  spanStart      Int
  spanEnd        Int
  isCandidate    Boolean        @default(false) // marked for LLM prioritization (spec §42)
  createdAt      DateTime       @default(now())

  document PolicyDocument      @relation(fields: [documentId], references: [id], onDelete: Cascade)
  concepts PolicyConcept[]
  sources  PolicyConceptSource[]

  @@index([documentId])
}

// ─── Phase 1: Policy Concept (Core semantic entity — spec §7) ──────────────

model PolicyConcept {
  id               String              @id @default(cuid())
  organizationId   String
  documentId       String
  unitId           String?
  conceptKey       String              // stable semantic merge key, e.g. personal_contact_information
  name             String              // display/technical name
  nameFa           String?
  descriptionFa    String
  category         String?
  sensitivity      ConceptSensitivity
  action           ConceptAction
  conditions       String              @default("[]")   // JSON: conditions / exceptions (spec §67)
  keywords         String              @default("[]")   // JSON: hint only, not detection mechanism (spec §41)
  detectorHints    String?             // JSON: {regex?, checksum?, dictionary?}
  sourceQuote      String              // mandatory provenance quote (spec §13/Rule 10)
  sourcePage       Int?
  confidence       Float               @default(0)
  reviewStatus     ConceptReviewStatus @default(REVIEW)
  extractedByModel String?             // e.g. qwen3:1.7b
  reviewNote       String?
  textHash         String?             // sha256 normalized identity for dedupe
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  organization Organization            @relation(fields: [organizationId], references: [id])
  document     PolicyDocument          @relation(fields: [documentId], references: [id], onDelete: Cascade)
  unit         PolicyUnit?             @relation(fields: [unitId], references: [id], onDelete: SetNull)
  examples     PolicyConceptExample[]
  sources      PolicyConceptSource[]
  embedding    PolicyConceptEmbedding?

  @@unique([documentId, conceptKey])
  @@index([organizationId, reviewStatus])
  @@index([documentId])
}

// ─── Phase 1: Multi-source provenance for PolicyConcept ────────────────────

model PolicyConceptSource {
  id        String   @id @default(cuid())
  conceptId String
  unitId    String?
  page      Int?
  quote     String
  quoteHash String
  createdAt DateTime @default(now())

  concept PolicyConcept @relation(fields: [conceptId], references: [id], onDelete: Cascade)
  unit    PolicyUnit?   @relation(fields: [unitId], references: [id], onDelete: SetNull)

  @@unique([conceptId, quoteHash])
  @@index([conceptId])
}

// ─── Phase 1: Positive/Negative Examples (spec §8) ─────────────────────────

model PolicyConceptExample {
  id        String   @id @default(cuid())
  conceptId String
  kind      String   // "POSITIVE" | "NEGATIVE"
  text      String
  createdAt DateTime @default(now())

  concept PolicyConcept @relation(fields: [conceptId], references: [id], onDelete: Cascade)

  @@index([conceptId])
}

// ─── Phase 1: Embedding Vector for Active Concepts (spec §16) ──────────────

model PolicyConceptEmbedding {
  id        String   @id @default(cuid())
  conceptId String   @unique
  vector    String   // JSON: number[] — only ACTIVE concepts indexed
  model     String   // embedding model identifier, e.g. bge-m3
  dim       Int
  textHash  String   // sha256 of embedded text to detect drift
  updatedAt DateTime @updatedAt

  concept PolicyConcept @relation(fields: [conceptId], references: [id], onDelete: Cascade)
}

